# Sanitized template: adapt the service account and NAS address before installation.
[Unit]
Description=arr-mcp loopback SSH tunnel to NASUS
Wants=network-online.target
After=network-online.target olm.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=admin
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -L 127.0.0.1:16060:127.0.0.1:6060 jesus@192.168.0.12
Restart=always
RestartSec=10
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
